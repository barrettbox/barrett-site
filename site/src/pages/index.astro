---
import BaseLayout from "../layouts/BaseLayout.astro";
import AppStoreCta from "../components/AppStoreCta.astro";
import { pricing, withBase } from "../lib/site";
---

<BaseLayout
  title="Passport Pack — Encrypted family documents on iPhone"
  description="Your passport isn’t a photo. Passport Pack keeps passports and family travel IDs encrypted on your iPhone — never saved to Photos."
>
  <section class="hero" aria-labelledby="brand">
    <div class="hero__atmosphere" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow hero__rise hero__rise--1">Encrypted on this iPhone</p>
        <h1 id="brand" class="display hero__brand hero__rise hero__rise--2">Passport Pack</h1>
        <p class="display hero__headline hero__rise hero__rise--3">Your passport isn’t a photo.</p>
        <p class="hero__support muted hero__rise hero__rise--4">
          Scan family travel IDs into an on-device vault under your master password. They never land
          in Photos.
        </p>
        <div class="hero__cta hero__rise hero__rise--5">
          <AppStoreCta />
        </div>
      </div>

      <div class="hero__visual hero__rise hero__rise--3" aria-hidden="true">
        <div class="pack">
          <div class="pack__glow"></div>
          <svg class="pack__art" viewBox="0 0 420 520" role="img">
            <defs>
              <linearGradient id="cover" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#2a2924"></stop>
                <stop offset="55%" stop-color="#1c1b17"></stop>
                <stop offset="100%" stop-color="#12110f"></stop>
              </linearGradient>
              <linearGradient id="page" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#f3ecdb"></stop>
                <stop offset="100%" stop-color="#d9d0bb"></stop>
              </linearGradient>
              <radialGradient id="brassSpot" cx="35%" cy="20%" r="65%">
                <stop offset="0%" stop-color="#dcc488" stop-opacity="0.35"></stop>
                <stop offset="100%" stop-color="#c7a765" stop-opacity="0"></stop>
              </radialGradient>
            </defs>
            <!-- Back page of the pack -->
            <rect
              x="72"
              y="48"
              width="280"
              height="400"
              rx="16"
              fill="url(#page)"
              transform="rotate(-4 212 248)"
              opacity="0.88"
            ></rect>
            <!-- Cover -->
            <rect x="48" y="36" width="300" height="420" rx="18" fill="url(#cover)"></rect>
            <rect
              x="48"
              y="36"
              width="300"
              height="420"
              rx="18"
              fill="url(#brassSpot)"
              opacity="0.9"
            ></rect>
            <rect
              x="48"
              y="36"
              width="300"
              height="420"
              rx="18"
              fill="none"
              stroke="#c7a765"
              stroke-opacity="0.35"
              stroke-width="1.5"
            ></rect>
            <path
              d="M78 78h70"
              stroke="#c7a765"
              stroke-width="2"
              stroke-linecap="round"
              opacity="0.85"
            ></path>
            <text
              x="78"
              y="118"
              fill="#eee8d9"
              font-family="Newsreader, serif"
              font-size="26"
              font-weight="500">Passport</text
            >
            <text
              x="78"
              y="148"
              fill="#d5cebd"
              font-family="DM Sans, sans-serif"
              font-size="13"
              letter-spacing="2.5">PACK</text
            >
            <rect x="78" y="190" width="168" height="112" rx="8" fill="#10100e"></rect>
            <rect
              x="78"
              y="190"
              width="168"
              height="112"
              rx="8"
              fill="none"
              stroke="#eee8d9"
              stroke-opacity="0.12"
            ></rect>
            <circle cx="118" cy="246" r="18" fill="none" stroke="#c7a765" stroke-width="1.5"
            ></circle>
            <path
              d="M110 246l5 5 11-12"
              fill="none"
              stroke="#c7a765"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
            <text
              x="148"
              y="242"
              fill="#d5cebd"
              font-family="DM Sans, sans-serif"
              font-size="11">Encrypted</text
            >
            <text
              x="148"
              y="258"
              fill="#9d9a8f"
              font-family="DM Sans, sans-serif"
              font-size="10">on this iPhone</text
            >
            <text
              x="78"
              y="340"
              fill="#9d9a8f"
              font-family="DM Sans, sans-serif"
              font-size="11">Never written to Photos</text
            >
            <!-- Front tipped page -->
            <rect
              x="210"
              y="72"
              width="162"
              height="360"
              rx="10"
              fill="url(#page)"
              transform="rotate(8 291 252)"
              opacity="0.96"
            ></rect>
            <rect
              x="226"
              y="108"
              width="98"
              height="10"
              rx="3"
              fill="#8f8774"
              transform="rotate(8 275 113)"
              opacity="0.45"
            ></rect>
            <rect
              x="226"
              y="132"
              width="118"
              height="8"
              rx="3"
              fill="#8f8774"
              transform="rotate(8 285 136)"
              opacity="0.28"
            ></rect>
            <rect
              x="226"
              y="152"
              width="108"
              height="8"
              rx="3"
              fill="#8f8774"
              transform="rotate(8 280 156)"
              opacity="0.22"
            ></rect>
            <rect
              x="236"
              y="210"
              width="90"
              height="118"
              rx="6"
              fill="#1d3140"
              transform="rotate(8 281 269)"
              opacity="0.9"
            ></rect>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <section class="foil" aria-labelledby="foil-title">
    <div class="container foil__inner">
      <p class="eyebrow">The Photos problem</p>
      <h2 id="foil-title" class="display foil__title">Recents is not a vault.</h2>
      <p class="foil__lede muted">
        A passport photo in Apple Photos syncs to iCloud Photos, shows up in Recents, and becomes
        readable to any app with library access. Passport Pack scans into a separate encrypted store —
        never into the camera roll.
      </p>
      <div class="foil__contrast" role="list">
        <article class="foil__col" role="listitem">
          <h3 class="foil__col-title">In Photos</h3>
          <ul>
            <li>Lives next to selfies and screenshots</li>
            <li>May sync across devices and shared libraries</li>
            <li>Any library-access app can see it</li>
          </ul>
        </article>
        <article class="foil__col foil__col--vault" role="listitem">
          <h3 class="foil__col-title">In Passport Pack</h3>
          <ul>
            <li>AES-GCM under your master password</li>
            <li>Face ID unlocks convenience — not the content key</li>
            <li>Never written to Photos</li>
          </ul>
        </article>
      </div>
      <p class="foil__more">
        <a href={withBase("/guides/passport-in-photos")}>Why a passport copy shouldn’t live in Photos →</a>
      </p>
    </div>
  </section>

  <section class="pricing" aria-labelledby="pricing-title">
    <div class="container">
      <header class="pricing__intro">
        <p class="eyebrow">Honest pricing</p>
        <h2 id="pricing-title" class="display pricing__title">Free proves it. Paid grows the archive.</h2>
        <p class="pricing__lede muted">
          Try the vault with three documents on Me. Upgrade when you need family profiles, more
          documents, or expiry reminders. Launch paid features do not include iCloud or CloudKit.
        </p>
      </header>
      <div class="pricing__grid">
        <article class="tier">
          <h3 class="tier__label">{pricing.free.label}</h3>
          <ul class="tier__list">
            {pricing.free.bullets.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article class="tier tier--paid">
          <h3 class="tier__label">{pricing.paid.label}</h3>
          <ul class="tier__list">
            {pricing.paid.bullets.map((item) => <li>{item}</li>)}
          </ul>
          <p class="tier__note muted">{pricing.paid.note}</p>
        </article>
      </div>
      <div class="pricing__cta">
        <AppStoreCta label="Get Passport Pack" />
      </div>
    </div>
  </section>

  <section class="paths" aria-labelledby="paths-title">
    <div class="container">
      <p class="eyebrow">Learn more</p>
      <h2 id="paths-title" class="display paths__title">Trust before download.</h2>
      <div class="paths__grid">
        <a class="path" href={withBase("/security")}>
          <span class="path__eyebrow">Architecture</span>
          <span class="path__title">Master password, AES-GCM, Face ID limits</span>
          <span class="path__more muted">Read the threat model →</span>
        </a>
        <a class="path" href={withBase("/guides/family-travel-documents")}>
          <span class="path__eyebrow">Guide</span>
          <span class="path__title">Family travel documents on one phone</span>
          <span class="path__more muted">Read the guide →</span>
        </a>
        <a class="path" href={withBase("/privacy")}>
          <span class="path__eyebrow">Privacy</span>
          <span class="path__title">No account. No ads. Support email.</span>
          <span class="path__more muted">Privacy &amp; support →</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 3.75rem);
    display: flex;
    align-items: center;
    padding: 3.5rem 0 4.5rem;
    overflow: clip;
  }

  .hero__atmosphere {
    pointer-events: none;
    position: absolute;
    inset: -10% -5% auto;
    height: 70%;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(199, 167, 101, 0.1), transparent 55%),
      radial-gradient(ellipse at 85% 30%, rgba(44, 42, 35, 0.9), transparent 50%);
    animation: fade-in 1.1s var(--ease-out) forwards;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 2.5rem 3rem;
    align-items: center;
  }

  .hero__copy {
    max-width: 34rem;
  }

  .hero__brand {
    margin: 0.7rem 0 0;
    font-size: clamp(3.1rem, 7.2vw, 5.1rem);
  }

  .hero__headline {
    margin: 1.15rem 0 0;
    font-size: clamp(1.55rem, 3.4vw, 2.15rem);
    color: var(--paper-muted);
    max-width: 18ch;
  }

  .hero__support {
    margin: 1.15rem 0 0;
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 34ch;
  }

  .hero__cta {
    margin-top: 1.85rem;
  }

  .hero__visual {
    display: flex;
    justify-content: center;
  }

  .pack {
    position: relative;
    width: min(100%, 420px);
    animation: pack-float 7s ease-in-out infinite;
  }

  .pack__glow {
    position: absolute;
    inset: 12% 8% 8%;
    background: radial-gradient(circle, rgba(199, 167, 101, 0.18), transparent 68%);
    filter: blur(18px);
  }

  .pack__art {
    position: relative;
    width: 100%;
    height: auto;
  }

  .hero__rise {
    animation: rise-in 0.85s var(--ease-out) forwards;
  }

  .hero__rise--1 {
    animation-delay: 0.05s;
  }
  .hero__rise--2 {
    animation-delay: 0.14s;
  }
  .hero__rise--3 {
    animation-delay: 0.24s;
  }
  .hero__rise--4 {
    animation-delay: 0.34s;
  }
  .hero__rise--5 {
    animation-delay: 0.44s;
  }

  .foil {
    padding: 4rem 0;
    border-top: 1px solid var(--line);
  }

  .foil__inner {
    max-width: 48rem;
  }

  .foil__title {
    margin: 0.75rem 0 0;
    font-size: clamp(2rem, 4vw, 2.85rem);
  }

  .foil__lede {
    margin: 1rem 0 0;
    font-size: 1.05rem;
    max-width: 40rem;
  }

  .foil__contrast {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2.5rem;
    margin-top: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .foil__col-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--paper-muted);
  }

  .foil__col--vault .foil__col-title {
    color: var(--brass-light);
  }

  .foil__col ul {
    margin: 0.85rem 0 0;
    padding-left: 1.1rem;
    color: var(--muted);
    display: grid;
    gap: 0.4rem;
    font-size: 0.95rem;
  }

  .foil__col li::marker {
    color: var(--brass);
  }

  .foil__more {
    margin: 1.75rem 0 0;
    font-size: 0.9375rem;
  }

  .foil__more a {
    color: var(--brass-light);
  }

  .foil__more a:hover {
    color: var(--paper);
  }

  .pricing {
    padding: 4rem 0;
    border-top: 1px solid var(--line);
    background:
      radial-gradient(ellipse 60% 50% at 100% 0%, rgba(199, 167, 101, 0.05), transparent 60%),
      transparent;
  }

  .pricing__intro {
    max-width: 40rem;
  }

  .pricing__title {
    margin: 0.75rem 0 0;
    font-size: clamp(2rem, 4vw, 2.85rem);
  }

  .pricing__lede {
    margin: 1rem 0 0;
    font-size: 1.05rem;
  }

  .pricing__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2rem;
    margin-top: 2.25rem;
  }

  .tier {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .tier__label {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--paper);
  }

  .tier--paid .tier__label {
    color: var(--brass-light);
  }

  .tier__list {
    margin: 1rem 0 0;
    padding-left: 1.1rem;
    color: var(--paper-muted);
    display: grid;
    gap: 0.4rem;
    font-size: 0.95rem;
  }

  .tier__list li::marker {
    color: var(--brass);
  }

  .tier__note {
    margin: 1rem 0 0;
    font-size: 0.8125rem;
    max-width: 28rem;
  }

  .pricing__cta {
    margin-top: 2rem;
  }

  .paths {
    padding: 4rem 0 4.5rem;
    border-top: 1px solid var(--line);
  }

  .paths__title {
    margin: 0.75rem 0 0;
    font-size: clamp(1.85rem, 3.5vw, 2.4rem);
  }

  .paths__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .path {
    display: grid;
    gap: 0.55rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--line);
    transition: color 160ms ease;
  }

  .path:hover .path__title {
    color: var(--brass-light);
  }

  .path__eyebrow {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .path__title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--paper);
  }

  .path__more {
    font-size: 0.875rem;
  }

  @media (max-width: 860px) {
    .hero {
      min-height: auto;
      padding-top: 2.25rem;
      padding-bottom: 3.25rem;
      align-items: start;
    }

    .hero__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero__visual {
      order: -1;
    }

    .pack {
      width: min(100%, 320px);
    }

    .hero__brand {
      font-size: clamp(2.6rem, 12vw, 3.8rem);
    }

    .foil__contrast,
    .pricing__grid,
    .paths__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
